{
  "name": "reminder-mailroom",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.app.config.ts",
    "dev:site": "vite --config vite.site.config.ts",
    "build": "npm run build:app && npm run build:site",
    "build:app": "vite build --config vite.app.config.ts",
    "build:site": "vite build --config vite.site.config.ts",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:web": "vitest run",
    "test:e2e": "playwright test",
    "test:installer": "sh tests/install.sh",
    "test:installer:windows": "pwsh -File tests/install.ps1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app site tests *.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.8",
    "@tauri-apps/api": "^2.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.5",
    "playwright-core": "1.58.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
